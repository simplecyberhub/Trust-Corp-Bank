# Development defaults. Never commit real values to this file.
NODE_ENV=development
PORT=3000
BASE_PATH=/
ALLOWED_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Server-only secrets (set them in Replit Secrets or Render Environment Variables)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
SUPABASE_DATABASE_URL=
ADMIN_SETUP_SECRET=
RESEND_API_KEY=
TERMII_API_KEY=

# Vite build-time public value; this is publishable, not a secret.
VITE_CLERK_PUBLISHABLE_KEY=